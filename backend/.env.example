# ==================== APP CONFIGURATION ====================
APP_NAME=RegiNova Backend
APP_VERSION=1.0.0
DEBUG=False

# ==================== DATABASE CONFIGURATION ====================
# For development (SQLite):
# DATABASE_URL=sqlite:///./reginova.db

# For production (PostgreSQL):
# DATABASE_URL=postgresql://username:password@localhost:5432/reginova
DATABASE_URL=sqlite:///./reginova.db

# ==================== JWT CONFIGURATION ====================
# Generate a secure secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ==================== GROQ API CONFIGURATION ====================
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3-70b-versatile

# ==================== CORS CONFIGURATION ====================
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://reginova.vercel.app"]

# ==================== DOCUMENT PROCESSING ====================
MAX_UPLOAD_SIZE=52428800
CHUNK_SIZE=1024
CHUNK_OVERLAP=128

# ==================== VECTOR STORE ====================
FAISS_INDEX_PATH=./faiss_indexes
VAULT_PATH=./vault

# ==================== OTP CONFIGURATION ====================
OTP_EXPIRATION_MINUTES=10
