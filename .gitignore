# ============================================================
# RegiNova — .gitignore
# Stack: FastAPI (Python) + React/Vite (Node.js)
# ============================================================

# ─── Python / FastAPI ────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/
.env_dir/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Test & coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json

# ─── Environment & Secrets ───────────────────────────────────
.env
.env.local
.env.production
.env.staging
*.env

# ─── Database ────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ─── FAISS / ML Indexes ──────────────────────────────────────
faiss_indexes/
*.index
*.faiss

# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ─── Uploaded / Vault Files ──────────────────────────────────
vault/
uploads/

# ─── Node.js / React / Vite ──────────────────────────────────
node_modules/
frontend/node_modules/

# Build output
frontend/dist/
dist/
.vite/

# npm / pnpm / yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ─── OS & Editor ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# VS Code
.vscode/
*.code-workspace

# JetBrains IDEs
.idea/
*.iml

# ─── Misc ────────────────────────────────────────────────────
*.bak
*.tmp
*.swp
*.swo
nul
DProjects*
